# Bases géo/ASN locales (volumineuses, sous licence, régénérables — cf. docs/PROCEDURE_BASES_GEO.md)
data/geo/
# Traçabilité des mises à jour de bases (fortilog.maj_bases)
*.maj.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Config RÉEL local (vraies données d'infra). Le config.yaml versionné est anonymisé.
config.local.yaml

# OS
.DS_Store

# Sorties d'analyse générées (le dossier de rapport par défaut)
/rapport/

# Référentiel généré par fortilog.confgen (contient de vraies valeurs)
config.generated.yaml
.serena/

# Environnement Python local créé par ./fortilog.sh
.venv/
